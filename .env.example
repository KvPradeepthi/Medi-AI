# ========================================================
# MediAI Platform Environment Variables
# ========================================================

# ----------------- MongoDB Database -----------------
# Connect to MongoDB Atlas (Recommended for deployment):
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/mediai?retryWrites=true&w=majority
# Or for local development with MongoDB: mongodb://localhost:27017/mediai
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mediai?retryWrites=true&w=majority

# ----------------- Authentication -------------------
# Secure JWT secret key for token hashing
JWT_SECRET=super_secret_jwt_key_mediai_2026_change_in_production
JWT_EXPIRES_IN=7d

# ----------------- Google Gemini AI -----------------
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ----------------- Cloudinary Storage ---------------
# Used for storing uploaded patient medical reports (PDF/images)
# Create a free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------- Server Settings ------------------
PORT=5000
NODE_ENV=production

# ----------------- AI Service URL -------------------
# Internal networking: In docker-compose use http://ai-service:8000
# For local standalone run use http://localhost:8000
# In cloud deployment use your deployed AI service URL (e.g. https://mediai-ai.onrender.com)
AI_SERVICE_URL=http://ai-service:8000

# ----------------- Frontend Client (Vite) -----------
# Note: For production deployment (e.g. Vercel / Netlify), set these in your hosting dashboard:
# VITE_API_BASE_URL=https://mediai-backend.onrender.com/api/v1
# VITE_AI_SERVICE_URL=https://mediai-ai.onrender.com/api/v1/ai
# VITE_SOCKET_URL=https://mediai-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_AI_SERVICE_URL=http://localhost:8000/api/v1/ai
VITE_SOCKET_URL=http://localhost:5000
